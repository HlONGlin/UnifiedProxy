[Unit]
Description=UnifiedProxy Mihomo Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/local/unifiedproxy
ExecStart=/usr/local/unifiedproxy/unifiedproxy --control
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
